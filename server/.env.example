PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/ecommerce
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CLIENT_URL=http://localhost:5173
# Only set this when deployed behind a reverse proxy (Render, Railway, nginx, etc.).
# It's the number of proxy hops to trust for X-Forwarded-For — usually 1
# ("true"/"false" also work). Leave unset for local development, or a client
# could spoof its IP and bypass rate limiting.
# TRUST_PROXY=1
